{
  "name": "conserium-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package:extension": "mkdir -p dist && cd extensions/browser && zip -FS -r ../../dist/conserium-clipper.zip manifest.json popup.html popup.css popup.js",
    "dev:turbo": "next dev",
    "generate:api": "openapi-typescript ${OPENAPI_SCHEMA:-http://localhost:8000/openapi.json} -o src/lib/api/generated/v1.ts",
    "check:api": "OPENAPI_SCHEMA=${OPENAPI_SCHEMA:-https://raw.githubusercontent.com/MaksymPushkash/cortex/main/openapi.json} npm run generate:api && git diff --exit-code -- src/lib/api/generated/v1.ts",
    "check:production-api": "OPENAPI_SCHEMA=${PRODUCTION_OPENAPI_SCHEMA:-https://api.conserium.app/openapi.json} npm run generate:api && git diff --exit-code -- src/lib/api/generated/v1.ts",
    "vercel-build": "npm run check:production-api && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.12",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^16.0.10",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "js-yaml": "^4.2.0",
    "postcss": "^8.5.10"
  }
}
