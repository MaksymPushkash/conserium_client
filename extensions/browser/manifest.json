{
  "manifest_version": 3,
  "name": "Conserium Clipper",
  "version": "0.1.0",
  "description": "Save the current page or selected text to Conserium.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://conserium.app/*", "https://api.conserium.app/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Conserium"
  }
}
